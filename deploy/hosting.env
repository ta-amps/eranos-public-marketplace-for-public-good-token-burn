# Settings for deploy/bootstrap-hosting.sh. KEY=value lines; names only, never a secret value.
APP=eranos-api
VOLUME=eranos_data
VOLUME_GB=1
FLY_ORG=personal
FLY_REGION=iad
# The edge secret's name on Fly; the Worker always calls it EDGE_SECRET.
EDGE_SECRET_NAME=ERANOS_EDGE_SECRET
EDGE_CONFIG=deploy/cloudflare/wrangler.jsonc
# Secrets typed with hidden input, space-separated. Enter skips one.
PROMPT_SECRETS=MODEL_API_KEY TESSERA_KEY
# Optional subdomain under the shared single apex domain (e.g. eranos.<your-domain>).
CUSTOM_DOMAIN=
HEALTH_URL=https://eranos.<your-subdomain>.workers.dev/api/health
GITHUB_REPO=ta-amps/eranos
