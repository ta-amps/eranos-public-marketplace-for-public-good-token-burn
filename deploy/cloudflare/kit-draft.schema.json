{
  "$defs": {
    "AgentSkillSpec": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "pattern": "^[a-z][a-z0-9-]{2,47}$",
          "title": "Name",
          "type": "string"
        },
        "description": {
          "maxLength": 300,
          "minLength": 10,
          "title": "Description",
          "type": "string"
        },
        "boundary": {
          "enum": [
            "drafts",
            "assists"
          ],
          "title": "Boundary",
          "type": "string"
        },
        "instructions": {
          "maxLength": 4000,
          "minLength": 20,
          "title": "Instructions",
          "type": "string"
        },
        "refuses": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Refuses",
          "type": "array"
        }
      },
      "required": [
        "name",
        "description",
        "boundary",
        "instructions",
        "refuses"
      ],
      "title": "AgentSkillSpec",
      "type": "object"
    },
    "CustomArtifactSpec": {
      "additionalProperties": false,
      "description": "Flexible deliverable unit (SOP playbook, HSDS directory schema, intake template, CSV formula\npack, or red-flag indicator pack) so volunteer agents are not limited to one rigid shape.",
      "properties": {
        "name": {
          "pattern": "^[a-z][a-z0-9_-]{2,47}$",
          "title": "Name",
          "type": "string"
        },
        "title": {
          "maxLength": 140,
          "minLength": 4,
          "title": "Title",
          "type": "string"
        },
        "artifact_format": {
          "enum": [
            "json_schema",
            "markdown_sop",
            "csv_template",
            "open_referral_hsds",
            "rule_pack",
            "checklist_pack"
          ],
          "title": "Artifact Format",
          "type": "string"
        },
        "boundary": {
          "default": "drafts",
          "enum": [
            "drafts",
            "assists"
          ],
          "title": "Boundary",
          "type": "string"
        },
        "summary": {
          "maxLength": 400,
          "minLength": 10,
          "title": "Summary",
          "type": "string"
        },
        "spec": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "string"
            }
          ],
          "title": "Spec"
        }
      },
      "required": [
        "name",
        "title",
        "artifact_format",
        "summary",
        "spec"
      ],
      "title": "CustomArtifactSpec",
      "type": "object"
    },
    "MCPToolSpec": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "pattern": "^[a-z][a-z0-9_]{2,47}$",
          "title": "Name",
          "type": "string"
        },
        "description": {
          "maxLength": 300,
          "minLength": 10,
          "title": "Description",
          "type": "string"
        },
        "input_schema": {
          "additionalProperties": true,
          "title": "Input Schema",
          "type": "object"
        },
        "output_fields": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Output Fields",
          "type": "array"
        },
        "read_only": {
          "default": true,
          "title": "Read Only",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "description",
        "input_schema",
        "output_fields"
      ],
      "title": "MCPToolSpec",
      "type": "object"
    },
    "ModelHook": {
      "additionalProperties": false,
      "description": "A kit ships no model: no model file, model download, tuned adapter or local model service.\nThe agent that uses the kit runs it with its own model, as process packages do.",
      "properties": {
        "default": {
          "const": "none",
          "type": "string",
          "default": "none",
          "title": "Default"
        },
        "uses": {
          "const": "your own agent's model",
          "default": "your own agent's model",
          "title": "Uses",
          "type": "string"
        }
      },
      "title": "ModelHook",
      "type": "object"
    },
    "SourceRef": {
      "additionalProperties": false,
      "properties": {
        "title": {
          "maxLength": 240,
          "minLength": 3,
          "title": "Title",
          "type": "string"
        },
        "url": {
          "pattern": "^https://",
          "title": "Url",
          "type": "string"
        },
        "checked_date": {
          "format": "date",
          "title": "Checked Date",
          "type": "string"
        }
      },
      "required": [
        "title",
        "url",
        "checked_date"
      ],
      "title": "SourceRef",
      "type": "object"
    },
    "SyntheticFixture": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^FX-[A-Z0-9-]{2,24}$",
          "title": "Id",
          "type": "string"
        },
        "scenario": {
          "maxLength": 240,
          "minLength": 5,
          "title": "Scenario",
          "type": "string"
        },
        "sample_input": {
          "maxLength": 2000,
          "minLength": 10,
          "title": "Sample Input",
          "type": "string"
        },
        "expected_indicators": {
          "items": {
            "type": "string"
          },
          "title": "Expected Indicators",
          "type": "array"
        },
        "expected_human_escalation": {
          "title": "Expected Human Escalation",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "scenario",
        "sample_input",
        "expected_human_escalation"
      ],
      "title": "SyntheticFixture",
      "type": "object"
    },
    "WorkflowStep": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_-]{1,39}$",
          "title": "Id",
          "type": "string"
        },
        "title": {
          "maxLength": 140,
          "minLength": 3,
          "title": "Title",
          "type": "string"
        },
        "kind": {
          "pattern": "^[a-z][a-z0-9_]{2,39}$",
          "title": "Kind",
          "type": "string"
        },
        "boundary": {
          "enum": [
            "drafts",
            "assists",
            "human_only"
          ],
          "title": "Boundary",
          "type": "string"
        },
        "actor": {
          "maxLength": 120,
          "minLength": 3,
          "title": "Actor",
          "type": "string"
        },
        "guidance": {
          "maxLength": 500,
          "minLength": 5,
          "title": "Guidance",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "kind",
        "boundary",
        "actor",
        "guidance"
      ],
      "title": "WorkflowStep",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "spdx_license": {
      "default": "Apache-2.0",
      "title": "Spdx License",
      "type": "string"
    },
    "tags": {
      "items": {
        "type": "string"
      },
      "title": "Tags",
      "type": "array"
    },
    "target_cohorts": {
      "items": {
        "type": "string"
      },
      "title": "Target Cohorts",
      "type": "array"
    },
    "producer_surface": {
      "default": "surface:eranos",
      "title": "Producer Surface",
      "type": "string"
    },
    "visibility_scope": {
      "default": "public_commons",
      "enum": [
        "surface_only",
        "allowlist_surfaces",
        "public_commons"
      ],
      "title": "Visibility Scope",
      "type": "string"
    },
    "allowed_surfaces": {
      "items": {
        "type": "string"
      },
      "title": "Allowed Surfaces",
      "type": "array"
    },
    "kit_id": {
      "pattern": "^[A-Z]{2,4}-[A-Z0-9]{2,8}-[0-9]{2}$",
      "title": "Kit Id",
      "type": "string"
    },
    "track_id": {
      "pattern": "^[a-z][a-z0-9-]{2,47}$",
      "title": "Track Id",
      "type": "string"
    },
    "domain": {
      "pattern": "^[a-z][a-z0-9_]{2,39}$",
      "title": "Domain",
      "type": "string"
    },
    "deliverable_kind": {
      "default": "full_kit",
      "pattern": "^[a-z][a-z0-9_]{2,39}$",
      "title": "Deliverable Kind",
      "type": "string"
    },
    "title": {
      "maxLength": 140,
      "minLength": 5,
      "title": "Title",
      "type": "string"
    },
    "summary": {
      "maxLength": 600,
      "minLength": 15,
      "title": "Summary",
      "type": "string"
    },
    "target_org": {
      "maxLength": 140,
      "minLength": 3,
      "title": "Target Org",
      "type": "string"
    },
    "steps": {
      "items": {
        "$ref": "#/$defs/WorkflowStep"
      },
      "minItems": 2,
      "title": "Steps",
      "type": "array"
    },
    "skill": {
      "anyOf": [
        {
          "$ref": "#/$defs/AgentSkillSpec"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "skills": {
      "items": {
        "$ref": "#/$defs/AgentSkillSpec"
      },
      "title": "Skills",
      "type": "array"
    },
    "tool": {
      "anyOf": [
        {
          "$ref": "#/$defs/MCPToolSpec"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "tools": {
      "items": {
        "$ref": "#/$defs/MCPToolSpec"
      },
      "title": "Tools",
      "type": "array"
    },
    "artifacts": {
      "items": {
        "$ref": "#/$defs/CustomArtifactSpec"
      },
      "title": "Artifacts",
      "type": "array"
    },
    "checklist": {
      "items": {
        "type": "string"
      },
      "minItems": 3,
      "title": "Checklist",
      "type": "array"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/SourceRef"
      },
      "minItems": 1,
      "title": "Sources",
      "type": "array"
    },
    "fixtures": {
      "items": {
        "$ref": "#/$defs/SyntheticFixture"
      },
      "minItems": 2,
      "title": "Fixtures",
      "type": "array"
    },
    "drafted_by": {
      "maxLength": 80,
      "minLength": 2,
      "title": "Drafted By",
      "type": "string"
    },
    "drafted_by_key": {
      "maxLength": 80,
      "minLength": 2,
      "title": "Drafted By Key",
      "type": "string"
    },
    "model_hook": {
      "$ref": "#/$defs/ModelHook"
    }
  },
  "required": [
    "kit_id",
    "track_id",
    "domain",
    "title",
    "summary",
    "target_org",
    "steps",
    "checklist",
    "sources",
    "fixtures",
    "drafted_by",
    "drafted_by_key"
  ],
  "title": "KitDraft",
  "type": "object"
}
