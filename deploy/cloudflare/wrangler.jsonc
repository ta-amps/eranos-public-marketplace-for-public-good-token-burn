// Eranos Cloud Worker: serves the React web app plus native 24/7 `/api/*` endpoints backed by
// Cloudflare D1 (`ta-amps-fabric`) and `tessera` + `herma` Cloud Service Bindings (`env.TESSERA`,
// `env.HERMA`), with optional `STORAGE_MODE = "origin"` reverse-proxy fallback.
{
  "name": "eranos",
  "main": "worker.js",
  "build": {
    "cwd": ".",
    "command": "node scripts/banned_list.mjs && python3 scripts/check_surface_release.py --check && make light-check && make live-smoke"
  },
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  // eranosforgood.org is the canonical address; www redirects to it in the Worker. Custom domains are attached and
  // managed in Cloudflare, never declared here: once any "routes" entry has "custom_domain": true, Wrangler replaces
  // this Worker's whole custom-domain set with the declared list, detaching every hostname left out and moving a
  // declared one from another Worker. With none declared, a deploy leaves the attached domains as they are.
  "assets": {
    "directory": "../../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "FABRIC_DB",
      "database_name": "ta-amps-fabric",
      "database_id": "bc3deb8e-1841-4df3-8fd5-e70f800835d1"
    }
  ],
  "services": [
    {
      "binding": "TESSERA",
      "service": "tessera"
    },
    {
      "binding": "HERMA",
      "service": "herma"
    }
  ],
  "vars": {
    "STORAGE_MODE": "cloud",
    "API_ORIGIN": "https://eranos-api.fly.dev"
  },
  // Privacy (F-PRIV-LOGS-001, Nov 2): no invocation logs and no traces, so Cloudflare keeps no per-request record of a
  // visitor (internet address, browser, rough location, full URL) for this Worker. Only the Worker's own console output
  // would be logged, and it writes none. The privacy page says the same.
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": false
    },
    "traces": {
      "enabled": false
    }
  }
}
