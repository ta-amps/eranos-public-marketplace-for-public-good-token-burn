# Names only. Copy to .env (gitignored) and fill in values yourself; agents never read .env.

# Optional Meta Model API key (starts with LLM_) for agent-assisted drafting. Standard mode only.
MODEL_API_KEY=

# Fabric: local (Tessera's in-process store) or tessera (the Tessera HTTP service)
ERANOS_BACKEND=local
ERANOS_LOCAL_DB=.eranos/local.db
TESSERA_URL=
TESSERA_KEY=

# Public name of the fabric on the pages
ERANOS_FABRIC_NAME=Tessera

# Run logs (JSON Lines)
ERANOS_TRACE=traces/run.jsonl
